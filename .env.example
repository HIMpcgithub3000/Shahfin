# 1. Renewing Free Tier AI Keys (Optional: deterministic local NLU + edge-tts work even without keys)
GROQ_API_KEY=your_free_groq_api_key_here
GEMINI_API_KEY=your_free_google_ai_studio_key_here

# 2. Database Configuration
# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5432/shaha_finlease):
POSTGRES_URL=postgresql://shaha_user:shaha_pass@localhost:5434/shaha_finlease
# Leave POSTGRES_URL empty to fall back to built-in SQLite (shaha_finlease.db) automatically
