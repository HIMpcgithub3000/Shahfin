# 1. AI & LLM Inference Keys (Optional: deterministic local NLU + edge-tts work even without keys)
GROQ_API_KEY=your_free_groq_api_key_here
GEMINI_API_KEY=your_free_google_ai_studio_key_here

# 2. Sarvam AI Keys (Optional: For Bulbul v3 / v4-flash TTS and Saaras v3 STT in Marathi/Hindi)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_SPEAKER=meera

# 3. Telephony (Bonus 5: Twilio Outbound Phone Dialing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BASE_WEBHOOK_URL=http://localhost:8000

# 4. Database Configuration
# PostgreSQL Database Connection URL (e.g. postgresql://user:password@localhost:5434/shaha_finlease):
POSTGRES_URL=postgresql://shaha_user:shaha_pass@localhost:5434/shaha_finlease
# Leave POSTGRES_URL empty to fall back to built-in SQLite (shaha_finlease.db) automatically
